{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalScribe",
  "version": "0.1.0",
  "identifier": "app.localscribe.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "LocalScribe", "width": 1280, "height": 900, "minWidth": 760, "minHeight": 600 }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost http://127.0.0.1:*; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Productivity",
    "shortDescription": "Private, offline audio and video transcription",
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-libav"]
      }
    },
    "resources": ["resources/**/*"],
    "externalBin": ["binaries/localscribe-ffmpeg", "binaries/localscribe-ffprobe", "binaries/localscribe-whisper-cli", "binaries/localscribe-whisper-avx2"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
